# ---------------------------------------------------------------------------
# CALL-E credentials  (https://docs.heycall-e.com/authentication)
# Get your key from the CALL-E dashboard. Server-side only — never ship to the
# frontend. Keys look like: iams_live_...
# ---------------------------------------------------------------------------
CALLE_API_KEY=

# ---------------------------------------------------------------------------
# Telephony mode
#   live   - place real CALL-E calls (spends call credit)
#   replay - replay recorded cassettes (free, deterministic)
#   auto   - live when CALLE_API_KEY is set AND budget remains, else replay
# ---------------------------------------------------------------------------
TELEPHONY_MODE=replay

# Record every live call to backend/cassettes/ so it can be replayed for free.
RECORD_CASSETTES=true

# ---------------------------------------------------------------------------
# Call budget guard. The hackathon grants 20 free calls; this is a hard ceiling
# enforced before every dial so a runaway re-plan loop cannot drain it.
# ---------------------------------------------------------------------------
CALL_BUDGET=20
MAX_CONCURRENT_CALLS=6

# Demo receiver numbers (E.164). These must be phones YOU own or are authorised
# to call — role-played admissions lines, never real facilities.
DEMO_PHONE_PRIMARY=
DEMO_PHONE_SECONDARY=

# ---------------------------------------------------------------------------
# Claude: LLM transcript review + case-manager brief
# The reviewer can only make findings MORE cautious, and only by quoting the
# facility verbatim. With no credentials it is skipped and the rule-based agent
# runs unchanged; the brief falls back to a template.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_REVIEW_ENABLED=true
LLM_MODEL=claude-opus-5
